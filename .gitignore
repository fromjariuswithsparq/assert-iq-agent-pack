# Rendered session-events config (generated by install.sh / install.ps1 with absolute pack root).
# The committed source is .assert-iq/dreaming/session-events.template.json.
.assert-iq/dreaming/session-events.json
# Rendered Claude Code hook wiring (matcher-group shape). Generated by
# install.sh / install.ps1 / bootstrap.*; the committed sources are
# claude-hooks.posix.template.json and claude-hooks.windows.template.json.
.assert-iq/dreaming/.claude-hooks.rendered.json

# Dreaming runtime — never ship the pack's own dream activity; every install
# starts with a clean slate (installers seed a fresh MEMORY.md + state.json).
# Committed source ships README.md, .gitignore and the topics/ .gitkeep.
#
# memory/logs/ and memory/.dream/ are NOT listed here: .assert-iq/memory/.gitignore
# is shipped into every workspace and ignores them in all install modes, and a
# deeper .gitignore outranks these rules anyway. Keep them in one place.
.assert-iq/memory/MEMORY.md
.assert-iq/memory/topics/*
!.assert-iq/memory/topics/.gitkeep
# Memory snapshots taken before each /dream cycle. These are tarballs of the
# consolidated memory store and can carry client-proprietary synthesized facts,
# so they must never be committed.
.assert-iq/dreaming/.snapshots/
transcripts/

# Oracle layer — grading outcomes are local artifacts, not tracked
.assert-iq/oracles/outcomes/
.assert-iq/oracles/**/*.lock

# Compiled Python artifacts from the optional dreaming service — never ship.
__pycache__/
*.pyc

# Generated Claude artifacts (created by install.sh / install.ps1 / scripts/bootstrap.*).
# .claude/settings.json is rendered from the session-events template with absolute pack root.
# .claude/skills is a symlink to ../.github/skills (or a copy on Windows without dev-mode).
.claude/settings.json
.claude/skills

# Bootstrap install manifest (per-workspace, contains absolute paths).
.assert-iq/.install-manifest.json

# OS / editor noise
.DS_Store
**/.DS_Store
Thumbs.db

# Python bytecode cache from the optional dreamer
__pycache__/
*.pyc

# PowerShell module analysis cache, created in-tree by child pwsh processes
# during the test suites when LOCALAPPDATA is not inherited.
Microsoft/
