{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash --noprofile --norc -c 'R=\"${CLAUDE_PLUGIN_ROOT:-__PACK_ROOT__}\"; export AIQ_PACK_ROOT=\"$R\"; S=\"$R/.assert-iq/dreaming/scripts/dream-gate.sh\"; [ -f \"$S\" ] || exit 0; chmod +x \"$S\" && \"$S\"'",
        "osx": "bash --noprofile --norc -c 'R=\"${CLAUDE_PLUGIN_ROOT:-__PACK_ROOT__}\"; export AIQ_PACK_ROOT=\"$R\"; S=\"$R/.assert-iq/dreaming/scripts/dream-gate.sh\"; [ -f \"$S\" ] || exit 0; chmod +x \"$S\" && \"$S\"'",
        "linux": "bash --noprofile --norc -c 'R=\"${CLAUDE_PLUGIN_ROOT:-__PACK_ROOT__}\"; export AIQ_PACK_ROOT=\"$R\"; S=\"$R/.assert-iq/dreaming/scripts/dream-gate.sh\"; [ -f \"$S\" ] || exit 0; chmod +x \"$S\" && \"$S\"'",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { $r = if ($env:CLAUDE_PLUGIN_ROOT) { $env:CLAUDE_PLUGIN_ROOT } else { '__PACK_ROOT__' }; $env:AIQ_PACK_ROOT = $r; $s = Join-Path $r '.assert-iq\\dreaming\\scripts\\dream-gate.ps1'; if (-not (Test-Path $s)) { exit 0 }; & $s }\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash --noprofile --norc -c 'R=\"${CLAUDE_PLUGIN_ROOT:-__PACK_ROOT__}\"; export AIQ_PACK_ROOT=\"$R\"; S=\"$R/.assert-iq/dreaming/scripts/dream-record-session.sh\"; [ -f \"$S\" ] || exit 0; chmod +x \"$S\" && \"$S\"'",
        "osx": "bash --noprofile --norc -c 'R=\"${CLAUDE_PLUGIN_ROOT:-__PACK_ROOT__}\"; export AIQ_PACK_ROOT=\"$R\"; S=\"$R/.assert-iq/dreaming/scripts/dream-record-session.sh\"; [ -f \"$S\" ] || exit 0; chmod +x \"$S\" && \"$S\"'",
        "linux": "bash --noprofile --norc -c 'R=\"${CLAUDE_PLUGIN_ROOT:-__PACK_ROOT__}\"; export AIQ_PACK_ROOT=\"$R\"; S=\"$R/.assert-iq/dreaming/scripts/dream-record-session.sh\"; [ -f \"$S\" ] || exit 0; chmod +x \"$S\" && \"$S\"'",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { $r = if ($env:CLAUDE_PLUGIN_ROOT) { $env:CLAUDE_PLUGIN_ROOT } else { '__PACK_ROOT__' }; $env:AIQ_PACK_ROOT = $r; $s = Join-Path $r '.assert-iq\\dreaming\\scripts\\dream-record-session.ps1'; if (-not (Test-Path $s)) { exit 0 }; & $s }\""
      }
    ]
  }
}
